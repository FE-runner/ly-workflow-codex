{
  "name": "ly-workflow-codex",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "description": "Codex 单 Agent 工作流 —— OpenSpec 生命周期 + 独立审查关卡 + GitFlow 发布管线",
  "author": {
    "name": "FE-runner"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FE-runner/ly-workflow-codex.git"
  },
  "bugs": {
    "url": "https://github.com/FE-runner/ly-workflow-codex/issues"
  },
  "keywords": [
    "codex",
    "openspec",
    "ai",
    "cli",
    "workflow"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "lycx": "bin/lycx.mjs"
  },
  "files": [
    "bin/lycx.mjs",
    "dist",
    "docs/codex-exec-contract.md",
    "templates/prompts/codex/",
    "templates/skills-codex/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "unbuild",
    "start": "node bin/lycx.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "ansis": "^4.1.0",
    "cac": "^6.7.14",
    "fs-extra": "^11.3.2",
    "i18next": "^25.5.2",
    "i18next-fs-backend": "^2.6.0",
    "inquirer": "^12.9.6",
    "ora": "^9.0.0",
    "pathe": "^2.0.3",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.1",
    "vitest": "^3.1.1"
  }
}
